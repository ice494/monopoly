<?xml version='1.0' encoding='utf-8'?>
<widget id="com.monopoly.game" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>大富翁</name>
    <description>经典地产经营游戏 - 官方规则</description>
    <author email="dev@monopoly.game" href="#">Monopoly Game</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <!-- 横屏模式 -->
    <preference name="Orientation" value="landscape" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="BackgroundColor" value="#FF1A1A2E" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="ShowSplashScreen" value="false" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="21" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="android-compileSdkVersion" value="33" />
        <preference name="android-buildToolsVersion" value="33.0.2" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="AndroidXEnabled" value="true" />
    </platform>

    <plugin name="cordova-plugin-whitelist" spec="1.3.5" />
</widget>
